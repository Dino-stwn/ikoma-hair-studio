import { defineStore } from 'pinia'
import { ref, watch } from 'vue'
import { loadOrSeed, save } from '@/utils/storage'
import { useAuthStore } from '@/stores/auth'
import payrollseed from '@/seed/payrolls.json'

const KEY = 'ikoma_payrolls'

export const usePayrollsStore = defineStore('payrolls', () => {
  const payrolls = ref(loadOrSeed(KEY, payrollseed))

  watch(payrolls, (val) => save(KEY, val), { deep: true })

  /**
   * Simpan rekap gaji mingguan.
   * Ditolak jika: bukan owner_cabang, atau minggu yang sama sudah ada.
   *
   * @param {{
   *   week_start: string, week_end: string,
   *   total_revenue: number, deduction: number, net_total: number,
   *   details: Array<{ user_id: string, amount: number }>
   * }} payload
   * @returns {{ ok: boolean, message?: string }}
   */
  function add(payload) {
    const auth = useAuthStore()
    if (auth.role !== 'owner_cabang')
      return { ok: false, message: 'Hanya Kepala Cabang yang dapat menyimpan rekap gaji.' }

    const duplicate = payrolls.value.find((p) => p.week_start === payload.week_start)
    if (duplicate)
      return { ok: false, message: `Rekap minggu ini (${payload.week_start}) sudah pernah disimpan.` }

    payrolls.value.push({
      id:            String(Date.now()),
      week_start:    payload.week_start,
      week_end:      payload.week_end,
      total_revenue: payload.total_revenue,
      deduction:     payload.deduction,
      net_total:     payload.net_total,
      created_by:    auth.currentUser.id,
      details:       payload.details   // [{ user_id, amount }]
    })
    return { ok: true }
  }

  function isWeekSaved(weekStart) {
    return payrolls.value.some((p) => p.week_start === weekStart)
  }

  return { payrolls, add, isWeekSaved }
})
</file>

<file path="src/stores/products.js">
import { defineStore } from 'pinia'
import { ref, watch } from 'vue'
import { loadOrSeed, save } from '@/utils/storage'
import { useAuthStore } from '@/stores/auth'
import productseed from '@/seed/products.json'

const KEY = 'ikoma_products'

// ── Helper status stok (diekspor agar bisa dipakai komponen) ─────────────────
/**
 * @param {{ stock: number, min_stock: number }} product
 * @returns {{ label: string, variant: 'danger'|'warning'|'success' }}
 */
export function getStockStatus(product) {
  if (product.stock === 0)                return { label: 'Habis',   variant: 'danger'  }
  if (product.stock <= product.min_stock) return { label: 'Menipis', variant: 'warning' }
  return                                         { label: 'Aman',    variant: 'success' }
}

export const useProductsStore = defineStore('products', () => {
  const products = ref(loadOrSeed(KEY, productseed))

  watch(products, (val) => save(KEY, val), { deep: true })

  // ── Helpers ──────────────────────────────────────────────────────────────
  function _nextId() {
    const ids = products.value.map((p) => Number(p.id)).filter(Boolean)
    return String(ids.length > 0 ? Math.max(...ids) + 1 : 1)
  }

  function _guardOwner() {
    const auth = useAuthStore()
    if (auth.role !== 'owner_cabang')
      return { ok: false, message: 'Hanya Kepala Cabang yang dapat mengubah data produk.' }
    return null
  }

  // ── Actions ──────────────────────────────────────────────────────────────
  function add(data) {
    const err = _guardOwner()
    if (err) return err
    products.value.push({
      id:        _nextId(),
      name:      data.name.trim(),
      type:      data.type,
      price:     Number(data.price),
      stock:     Number(data.stock),
      min_stock: Number(data.min_stock)
    })
    return { ok: true }
  }

  function update(id, data) {
    const err = _guardOwner()
    if (err) return err
    const idx = products.value.findIndex((p) => p.id === id)
    if (idx === -1) return { ok: false, message: 'Produk tidak ditemukan.' }
    Object.assign(products.value[idx], {
      name:      data.name.trim(),
      type:      data.type,
      price:     Number(data.price),
      stock:     Number(data.stock),
      min_stock: Number(data.min_stock)
    })
    return { ok: true }
  }

  /**
   * Tambah (delta > 0) atau kurangi (delta < 0) stok.
   * Tidak memerlukan guard role karena dipanggil juga oleh transactions.add()
   * yang bisa diakses owner_cabang dan karyawan.
   * Stok tidak boleh turun di bawah 0.
   */
  function adjustStock(id, delta) {
    const idx = products.value.findIndex((p) => p.id === id)
    if (idx === -1) return
    const next = products.value[idx].stock + Number(delta)
    products.value[idx].stock = Math.max(0, next)
  }

  function getById(id) {
    return products.value.find((p) => p.id === id) ?? null
  }

  return { products, add, update, adjustStock, getById }
})
</file>

<file path="src/stores/services.js">
import { defineStore } from 'pinia'
import { ref, computed, watch } from 'vue'
import { loadOrSeed, save } from '@/utils/storage'
import { useAuthStore } from '@/stores/auth'
import serviceseed from '@/seed/services.json'

const KEY = 'ikoma_services'

export const useServicesStore = defineStore('services', () => {
  const services = ref(loadOrSeed(KEY, serviceseed))

  watch(services, (val) => save(KEY, val), { deep: true })

  // ── Getters ──────────────────────────────────────────────────────────────
  const activeServices = computed(() =>
    services.value.filter((s) => s.is_active)
  )

  // ── Helpers ───────────────────────────────────────────────────────────────
  function _nextId() {
    const ids = services.value.map((s) => Number(s.id)).filter(Boolean)
    return String(ids.length > 0 ? Math.max(...ids) + 1 : 1)
  }

  function _guardOwner() {
    const auth = useAuthStore()
    if (auth.role !== 'owner_cabang')
      return { ok: false, message: 'Hanya Kepala Cabang yang dapat mengubah data layanan.' }
    return null
  }

  // ── Actions ───────────────────────────────────────────────────────────────
  function add(data) {
    const err = _guardOwner()
    if (err) return err
    services.value.push({
      id:        _nextId(),
      name:      data.name.trim(),
      price:     Number(data.price),
      is_active: true
    })
    return { ok: true }
  }

  function update(id, data) {
    const err = _guardOwner()
    if (err) return err
    const idx = services.value.findIndex((s) => s.id === id)
    if (idx === -1) return { ok: false, message: 'Layanan tidak ditemukan.' }
    Object.assign(services.value[idx], {
      name:  data.name.trim(),
      price: Number(data.price)
    })
    return { ok: true }
  }

  /**
   * "Hapus" = nonaktifkan (soft-delete), bukan benar-benar menghapus baris.
   * Data tetap ada di localStorage agar riwayat transaksi tetap konsisten.
   */
  function remove(id) {
    const err = _guardOwner()
    if (err) return err
    const idx = services.value.findIndex((s) => s.id === id)
    if (idx === -1) return { ok: false, message: 'Layanan tidak ditemukan.' }
    services.value[idx].is_active = false
    return { ok: true }
  }

  function getById(id) {
    return services.value.find((s) => s.id === id) ?? null
  }

  function isNameTaken(name, excludeId = null) {
    const normalized = name.trim().toLowerCase()
    return services.value.some(
      (s) =>
        s.is_active &&
        s.name.trim().toLowerCase() === normalized &&
        s.id !== excludeId
    )
  }

  return { services, activeServices, add, update, remove, getById, isNameTaken }
})
</file>

